# Copy to .env and adjust as needed. All values have sensible local defaults.
APP_NAME=Athletrix Engine
APP_VERSION=0.1.0
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call this API (the Athletrix_Web dev server).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Local SQLite database file (created automatically, parent folder included).
# Relative to the folder you start the backend from. Use a separate file for an isolated demo.
DATABASE_PATH=data/athletrix.db
# Distance estimate rules (adjustable engineering defaults, not sport-specific standards).
# Consecutive tracking samples more than this many seconds apart are not bridged (0 < value <= 60).
DISTANCE_MAX_GAP_SECONDS=3.0
# Both ends of an interval need at least this tracking_confidence to count (0..1).
DISTANCE_MIN_CONFIDENCE=0.5
# Speed at or above which time and distance count as high-speed, in m/s (positive, finite).
# 5.0 is a demonstration default, not a validated standard for every sport or athlete.
HIGH_SPEED_THRESHOLD_MPS=5.0
# Retention caps: newest samples kept per athlete, separately per stream (positive integers, default 300 each).
# A count, not a time span: 300 tracking samples at 10 Hz is 30 s; 3000 is about five minutes only at 10 Hz.
# Applied by each accepted sample's insert-plus-trim write; startup never prunes stored rows, so a reduced cap
# takes effect for an athlete's stream at its next accepted sample and a raised cap brings nothing back.
# Example profile for a 10 Hz tracking source: PHYSIOLOGICAL_RETENTION_SAMPLES=300, TRACKING_RETENTION_SAMPLES=3000.
PHYSIOLOGICAL_RETENTION_SAMPLES=300
TRACKING_RETENTION_SAMPLES=300
# Optional code revision recorded in each recording's start-time configuration snapshot, as supplied (not checked;
# the engine never runs git). Unset = "unknown". Example: CODE_REVISION=$(git rev-parse --short HEAD) when starting.
# CODE_REVISION=
