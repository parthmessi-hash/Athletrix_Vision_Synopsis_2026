{
  "format": "athletrix-video-tracking-config",
  "format_version": 1,
  "detector": {
    "model": "yolox_s",
    "input_size": 640,
    "score_threshold": 0.1,
    "nms_iou_threshold": 0.45,
    "backend": "opencv-dnn"
  },
  "tracker": {
    "implementation": "trackers.ByteTrackTracker",
    "lost_track_buffer": 30,
    "track_activation_threshold": 0.5,
    "minimum_consecutive_frames": 3,
    "minimum_iou_threshold": 0.1,
    "high_conf_det_threshold": 0.5
  },
  "ground_point": "bbox_bottom_centre",
  "drop_boxes_touching_bottom_edge": true,
  "min_box_height_px": 12.0,
  "max_time_mismatch_frames": 0.5,
  "ground_contact_rule": "box_height_consistency",
  "ground_min_height_ratio": 0.85,
  "ground_reference_frames": 15,
  "ground_min_reference": 5
}
